      "entry": { "html": "pages/index.html" },
      "webtools": {
        "shellLayout": "sidebar-iframe",
        "defaultSkin": "amd-gold"
      },
      "dependencies": {
        "webtoolsModules": ["shell", "chat-orb", "demo-engine", "voice", "chrome", "mobile-drawer"]
      }
    },
    {

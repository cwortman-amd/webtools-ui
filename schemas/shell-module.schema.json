{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cwortman-amd/webtools-ui/schemas/shell-module.schema.json",
  "title": "Dashboard shell module registry",
  "description": "Declarative sidebar tab definitions for dashboard (sidebar-iframe) plugins.",
  "type": "object",
  "required": ["modules"],
  "additionalProperties": false,
  "properties": {
    "defaultTab": {
      "type": "string",
      "description": "Initial tab id when URL has no ?tab= parameter."
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "required": ["id", "label", "icon", "panel"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stable tab id; matches data-tab and panel-{id}."
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "description": "Material Symbols ligature (material-symbols-outlined)."
        },
        "mode": {
          "type": "string",
          "enum": ["standard", "advanced", "expert"],
          "default": "standard"
        },
        "order": {
          "type": "integer",
          "default": 0
        },
        "title": {
          "type": "string",
          "description": "Optional tooltip (title attribute)."
        },
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "When false, module is registered but hidden until setEnabled(true)."
        },
        "replaces": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Unregister this module id before registering (swap pattern)."
        },
        "provider": {
          "type": "string",
          "description": "Source plugin id when module is imported from a sibling (future host)."
        },
        "placement": {
          "type": "string",
          "enum": ["nav", "bottom"],
          "default": "nav",
          "description": "nav = .sidebar-nav; bottom = .sidebar-bottom utility stack."
        },
        "panel": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["iframe", "html"]
            },
            "src": {
              "type": "string",
              "description": "Iframe URL (required when type=iframe)."
            },
            "lazy": {
              "type": "boolean",
              "default": true,
              "description": "Defer load via data-src until first activation."
            },
            "html": {
              "type": "string",
              "description": "Inline panel HTML (required when type=html)."
            }
          }
        }
      }
    }
  }
}
